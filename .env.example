# Copy to .env.local (gitignored) for local development.

# Required by the Vite dev/preview proxy, which adds it as X-Staging-Key on /v1 requests.
# Never prefix with VITE_: that would ship it in the browser bundle.
STAGING_KEY=

# Optional: where the proxy forwards /v1 (defaults to the staging API).
# API_PROXY_TARGET=https://api-staging.pnlinternationalltd.com

VITE_DEFAULT_CURRENCY=USD
